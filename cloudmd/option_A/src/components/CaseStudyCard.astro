---
interface Props {
  title: string;
  summary: string;
  sector: string;
  role: string;
  duration: string;
  stack: string[];
  results: { metric: string; value: string }[];
  slug: string;
  lang: string;
}

const { title, summary, sector, role, duration, stack, results, slug, lang } = Astro.props;
---

<div class="bg-surface rounded-xl border border-blue/10 p-6 hover:border-blue/25 transition-all">
  <div class="flex flex-wrap gap-2 mb-4 text-xs text-text-dim">
    <span class="px-2 py-1 bg-bg rounded">{sector}</span>
    <span class="px-2 py-1 bg-bg rounded">{role}</span>
    <span class="px-2 py-1 bg-bg rounded">{duration}</span>
  </div>
  
  <h3 class="text-xl font-bold mb-2 text-text">{title}</h3>
  <p class="text-text-dim mb-4">{summary}</p>
  
  <div class="flex flex-wrap gap-2 mb-6">
    {stack.map((tech) => (
      <span class="text-xs px-2 py-1 bg-blue/10 text-blue rounded-full">{tech}</span>
    ))}
  </div>
  
  <div class="flex flex-wrap gap-4 mb-6">
    {results.map((result) => (
      <div class="chip-gold text-sm px-3 py-1 bg-[#C9A227]/10 text-[#C9A227] rounded border border-[#C9A227]/20 flex flex-col sm:flex-row sm:items-baseline gap-1">
        <span class="font-bold">{result.value}</span> 
        <span class="opacity-80">{result.metric}</span>
      </div>
    ))}
  </div>
  
  <a href={`/${lang}/work/${slug}`} class="text-blue hover:underline font-medium inline-flex items-center gap-1">
    {lang === 'zh' ? '阅读完整案例研究 →' : 'Read full case study →'}
  </a>
</div>
