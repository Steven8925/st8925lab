---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
---

<BaseLayout title="About | ST8925 LAB" description="About ST8925 LAB" lang="en">
  <div class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold mb-8">About</h1>
    <div class="prose prose-lg text-gray-700 mb-12">
      <p>ST8925 LAB is an independent engineering consultancy specializing in industrial connectivity, OT/IT convergence, and facility modernization.</p>
      <p>We believe in practical, robust solutions that unlock data from legacy assets without introducing unnecessary complexity or risk.</p>
      
      <h2>Experience Areas</h2>
      <ul>
        <li>Critical Facilities (Data Centers, Hotels, Hospitals)</li>
        <li>Industrial IoT and Edge Computing</li>
        <li>BMS / SCADA Integration</li>
        <li>Hardware Prototyping and Firmware Development</li>
      </ul>

      <h2>Technical Proficiencies</h2>
      <ul>
        <li><strong>Protocols:</strong> Modbus RTU/TCP, BACnet MS/TP & IP, MQTT, OPC UA</li>
        <li><strong>Hardware:</strong> ESP32, Raspberry Pi, Industrial Gateways, RS-485 / RS-232 transceivers</li>
        <li><strong>Software:</strong> C/C++, Node.js, Python, InfluxDB, Grafana</li>
      </ul>
    </div>
    
    <ContactCTA lang="en" />
  </div>
</BaseLayout>
