---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Capabilities | ST8925 LAB" description="Our core competencies in industrial OT/IT integration" lang="en">
  <div class="max-w-5xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold mb-4">Capabilities</h1>
    <p class="text-xl text-gray-600 mb-12">Professional services bridging operational technology and IT systems.</p>
    
    <div class="space-y-8">
      <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <div class="flex items-start gap-4">
          <div class="text-4xl">🔌</div>
          <div>
            <h2 class="text-2xl font-bold mb-2">OT/IT Network Integration & Purdue Model Layering</h2>
            <p class="text-gray-600">Design and implement network architectures that bridge operational technology and enterprise IT securely, adhering to the Purdue Enterprise Reference Architecture (PERA).</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <div class="flex items-start gap-4">
          <div class="text-4xl">📡</div>
          <div>
            <h2 class="text-2xl font-bold mb-2">Legacy Equipment Protocol Integration</h2>
            <p class="text-gray-600">Connect existing industrial equipment (chillers, generators, BMS controllers) to modern monitoring systems using robust protocol translation (Modbus, BACnet, OPC UA).</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <div class="flex items-start gap-4">
          <div class="text-4xl">📊</div>
          <div>
            <h2 class="text-2xl font-bold mb-2">Facility Monitoring Platform Deployment</h2>
            <p class="text-gray-600">Deploy end-to-end monitoring platforms with dashboards, alerting, and historical trend analysis to give facility teams real-time operational visibility.</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <div class="flex items-start gap-4">
          <div class="text-4xl">🔍</div>
          <div>
            <h2 class="text-2xl font-bold mb-2">Network Device Selection & Compliance Audit</h2>
            <p class="text-gray-600">Evaluate and select industrial networking equipment against EN50155, IEC 61850-3, and other relevant compliance standards for harsh environments.</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <div class="flex items-start gap-4">
          <div class="text-4xl">📋</div>
          <div>
            <h2 class="text-2xl font-bold mb-2">Project Delivery Documentation</h2>
            <p class="text-gray-600">Build complete delivery documentation systems including FAT (Factory Acceptance Testing), SAT (Site Acceptance Testing), and UAT (User Acceptance Testing) plans.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
