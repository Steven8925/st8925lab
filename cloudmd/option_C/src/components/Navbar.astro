---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ContactCTA from './ContactCTA.astro';
import { getLangFromUrl, useTranslations } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
const pathname = Astro.url.pathname;

const navLinks = [
  { href: `/${lang}/work`, label: t('nav.work') || 'Work' },
  { href: `/${lang}/reference`, label: t('nav.reference') || 'Reference' },
  { href: `/${lang}/tools`, label: t('nav.tools') || 'Tools' },
  { href: `/${lang}/capabilities`, label: t('nav.capabilities') || 'Capabilities' },
  { href: `/${lang}/about`, label: t('nav.about') || 'About' },
];

const isActive = (href: string) => {
  // exact match for home or startsWith for sections (simple heuristic)
  if (href === `/${lang}/` || href === `/${lang}`) {
    return pathname === href ? 'text-blue border-b-2 border-blue' : 'text-text hover:text-blue';
  }
  return pathname.startsWith(href) ? 'text-blue border-b-2 border-blue' : 'text-text hover:text-blue';
};
---

<nav class="sticky top-0 z-50 bg-bg/90 backdrop-blur-lg border-b border-blue/10">
  <div class="container mx-auto px-4 max-w-6xl h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${lang}/`} class="flex items-center gap-1 group">
      <span class="font-bold text-text text-xl tracking-tight group-hover:text-blue transition-colors">ST8925</span>
      <span class="text-[#C9A227] text-xl leading-none">&bull;</span>
      <span class="text-text-dim font-medium text-sm mt-1">LAB</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center h-full gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class={`text-sm font-medium h-full flex items-center transition-colors ${isActive(link.href)}`}>
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right Actions -->
    <div class="hidden md:flex items-center gap-4">
      <LanguageSwitcher />
      <ContactCTA lang={lang} />
    </div>

    <!-- Mobile Toggle -->
    <button id="mobile-toggle" class="md:hidden text-text p-2 hover:bg-surface rounded transition-colors" aria-label="Toggle Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-surface border-b border-blue/10 px-4 py-4 shadow-lg absolute w-full">
    <div class="flex flex-col gap-4 mb-6">
      {navLinks.map((link) => (
        <a href={link.href} class={`text-base font-medium py-2 ${pathname.startsWith(link.href) ? 'text-blue' : 'text-text'}`}>
          {link.label}
        </a>
      ))}
    </div>
    <div class="flex items-center justify-between pt-4 border-t border-blue/10">
      <LanguageSwitcher />
      <ContactCTA lang={lang} />
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
