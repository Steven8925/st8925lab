# st8925lab — HTTP 安全標頭 / HTTP security headers
#
# 為什麼用 _headers 而不是 Worker / Why this file and not the Worker
# ------------------------------------------------------------------
# wrangler.jsonc 的 run_worker_first 只把 /api/* 送進 Worker，其餘路徑由靜態
# 資產直接回應、完全不經過 Worker 程式碼。所以 worker/index.js 裡加標頭只會
# 影響 API 回應，對真正需要 CSP 的 HTML 頁面毫無作用。
# 改用 run_worker_first: true 會讓每一個請求都經過 Worker —— 多一層延遲與成本，
# 而且 Worker 一有 bug 就是整站掛掉。為了加標頭承擔那個風險並不划算。
#
# The Worker only sees /api/*; every other path is served straight from the
# asset store. Adding headers in Worker code would therefore not protect the
# HTML pages that actually need a CSP.
#
# CSP 的誠實說明 / An honest note on the CSP
# ------------------------------------------
# 下面的 CSP **帶著 'unsafe-inline' 與 'unsafe-eval'**，因為現況需要：
#   - 每一頁都有大量 inline <style>（index.html 就有 263 行）與 inline <script>
#   - Travel-Assistance 用 cdn.tailwindcss.com（Play CDN），它在瀏覽器端即時
#     編譯 CSS，必須有 'unsafe-eval'
# 所以這份 CSP **擋不住 inline 注入**，它擋的是「從未授權網域載入資源」與
# 「被嵌進別人的 iframe」。那仍然是實質改善，但不要誤以為 XSS 就此免疫。
# 要真正收緊，必須先做 Phase 3（把 inline script 抽出）並移除 Play CDN ——
# 那兩件事都在 DEFECTS.md 裡有對應項目。
#
# This CSP carries 'unsafe-inline' and 'unsafe-eval' because the site currently
# requires both. It restricts *origins*, not inline injection. Tightening it
# depends on extracting inline scripts and dropping the Tailwind Play CDN.

/*
  # 瀏覽器不得用自己的猜測覆蓋我們宣告的 Content-Type。
  # 這是成本最低、效果最確定的一條。
  X-Content-Type-Options: nosniff

  # 禁止被嵌入 iframe（點擊劫持）。frame-ancestors 是現代做法，
  # X-Frame-Options 留著給舊瀏覽器。
  X-Frame-Options: DENY

  # 跨站導覽時只送來源網域，不送完整路徑與查詢字串。
  Referrer-Policy: strict-origin-when-cross-origin

  # 明確關閉本站不使用的裝置權限。
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # 一年份 HSTS，含子網域並預載。
  # 注意：這是難以回頭的設定 —— 一旦瀏覽器記住，該網域在到期前都只能走 HTTPS。
  # 本站本來就只有 HTTPS，所以風險可接受。
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 跨網域政策檔一律不允許。
  X-Permitted-Cross-Domain-Policies: none

  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://cdn.sheetjs.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://unpkg.com https://fonts.gstatic.com; connect-src 'self' https://st8925lab-travel-assistance.onrender.com https://st8925lab-alarm-api.onrender.com https://st8925lab-alarm-ops.onrender.com https://*.tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
