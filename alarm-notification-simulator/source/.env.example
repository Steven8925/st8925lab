# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# 複製本檔為 .env 並填入實際值。切勿將 .env 提交進版控。
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Notification API (apps/api) -------------------------------------------
API_PORT=3000
# SQLite for the simulation phase. Swap to a postgresql:// URL and change the
# provider in prisma/schema.prisma to migrate to PostgreSQL.
# 模擬階段使用 SQLite。改為 postgresql:// 並修改 schema.prisma 的 provider 即可遷移。
DATABASE_URL="file:./data/dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Must be identical in apps/api and apps/ops-server. Different from JWT_SECRET.
# apps/api 與 apps/ops-server 必須一致，且不可與 JWT_SECRET 相同。
INTERNAL_WEBHOOK_SECRET=replace-with-a-different-long-random-secret

# simulator = WebSocket phone simulator (Phase A)
# expo      = real Expo Push Service -> FCM/APNs (Phase B)
PUSH_PROVIDER=simulator

# Simulated latency between push ticket and delivery receipt, milliseconds.
# Models the real async gap so the simulation exercises the production code path.
# 模擬 ticket 與 receipt 之間的非同步延遲（毫秒），讓模擬走的是正式環境的程式路徑。
SIMULATOR_RECEIPT_DELAY_MS=3000

# Only used when PUSH_PROVIDER=expo (Phase B)
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=

# The single timezone alarm reference codes (TANK01-20260813-01) are dated in,
# and therefore the timezone whose midnight resets each device's daily counter.
# Deliberately NOT per-device: one alarm must not be called a different day by
# its sender and its reader.
# 告警編號日期所依據的唯一時區，也決定每日序號在哪個時區的午夜歸零。
ALARM_REFERENCE_TIMEZONE=Asia/Taipei

# How many days of simulation data to keep. 0 disables retention entirely.
# The console header STATES this figure to the operator, so it is enforced by a
# sweeper (src/maintenance/retention.ts), not merely displayed. Alarms and their
# cascade go, plus the webhook idempotency table; per-device sequence counters
# and user/device rows are deliberately kept.
# 主控台標題會向操作者宣告這個天數，因此它由清除器實際執行，不是只顯示。
TEST_DATA_RETENTION_DAYS=3
TEST_DATA_RETENTION_SWEEP_MS=3600000

CORS_ORIGIN=http://localhost:5173

# Seeded demo accounts - development only.
SEED_MANAGER_EMAIL=manager@demo.local
SEED_ADMIN_EMAIL=admin@demo.local
SEED_PASSWORD=replace-with-a-development-password

# --- Simulated operations server (apps/ops-server) -------------------------
OPS_PORT=4000
NOTIFICATION_API_BASE_URL=http://localhost:3000
OPS_CORS_ORIGIN=http://localhost:5173

# --- Simulation web UI (apps/web) ------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_OPS_BASE_URL=http://localhost:4000

# Development convenience ONLY - prefills the phone login field.
# Vite inlines every VITE_* var into the client bundle; never a real credential.
VITE_DEMO_PASSWORD=

# --- Pull-based ingestion ---------------------------------------------------
# For customer systems that only write a row to their own database and expect
# a program to come and read it. SOURCE_POLL_INTERVAL_MS is the FLOOR ON ALARM
# LATENCY: a red-light reading can wait up to one full interval.
# 客戶系統只寫入自己的資料庫時使用。輪詢間隔即告警延遲的下限。
SOURCE_POLL_ENABLED=true
SOURCE_POLL_INTERVAL_MS=5000
SOURCE_POLL_URL=http://localhost:4000/v1/source-events/claim
