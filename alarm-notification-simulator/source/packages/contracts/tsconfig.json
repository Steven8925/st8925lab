{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is included for the standard fetch / URLSearchParams typings only.
    // This package must stay runtime-agnostic so the Phase B React Native app
    // can consume it unchanged - no DOM API is actually called.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
